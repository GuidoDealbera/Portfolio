# Copiá este archivo a .env.local y completá los valores.
# .env.local no se sube a Git. En producción, cargá las mismas variables en
# Vercel: Project Settings → Environment Variables.

# Clave de API de Resend (https://resend.com/api-keys), empieza con "re_".
# Si queda vacía, en desarrollo el mensaje se imprime en la consola en lugar
# de enviarse; en producción el formulario avisa que no pudo enviar.
RESEND_API_KEY=

# A dónde llegan los mensajes del formulario.
# Mientras no verifiques un dominio en Resend, tiene que ser el mismo email
# con el que creaste la cuenta de Resend: a cualquier otro devuelve error 403.
# Si queda vacío se usa el email de src/content/site.ts.
CONTACT_TO_EMAIL=

# Remitente. Si queda vacío se usa "Portfolio <onboarding@resend.dev>", que
# funciona sin dominio propio. Con dominio verificado:
#   CONTACT_FROM=Portfolio <contacto@tudominio.com>
CONTACT_FROM=
